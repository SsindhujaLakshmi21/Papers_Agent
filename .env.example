# ==============================================================================
# Scheduled Daily CS Papers Configuration
# ==============================================================================

# Gmail Sender Credentials
# 1. Enable 2-Step Verification on your Google Account: https://myaccount.google.com/security
# 2. Generate an App Password (16 letters): https://myaccount.google.com/apppasswords
# 3. Enter your Gmail address and generated App Password below (spaces removed):
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password

# Recipient Email Address (default: s.sindhu210506@gmail.com)
RECIPIENT_EMAIL=s.sindhu210506@gmail.com

# Optional Gemini API Key for AI Analysis
# Free key can be obtained at: https://aistudio.google.com/app/apikey
# If omitted or empty, the built-in heuristic extractive summarizer is used.
GEMINI_API_KEY=

# Settings
PAPERS_PER_DAY=5
LOG_LEVEL=INFO
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
USE_TLS=True
